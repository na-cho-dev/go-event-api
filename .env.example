# Copy to .env for local development. Every variable is read by internal/config.

# development | production | test
ENV=development

# TCP port. Render sets PORT automatically.
PORT=8080

# PostgreSQL connection string (required).
DATABASE_URL=postgres://app:app@localhost:5440/go_event_api?sslmode=disable

# Apply pending migrations at startup.
AUTO_MIGRATE=true

# Signs access tokens (required). Use at least 32 random characters in production:
#   openssl rand -base64 48
JWT_SECRET=local-development-secret-change-me-please

# bcrypt work factor for password hashes (12 is a good default; raise on fast hardware).
BCRYPT_COST=12

# Access-token lifetime as a Go duration (24h, 90m, 15m).
JWT_TTL=24h

# Comma-separated browser origins, or * for any.
CORS_ORIGINS=*

# Per-client rate limit. Set RATE_LIMIT_RPS=0 to disable.
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20

# Largest accepted request body in bytes.
MAX_BODY_BYTES=1048576

# debug | info | warn | error, and json | text (json by default in production).
LOG_LEVEL=info
LOG_FORMAT=text

# Serve Swagger UI at /swagger/.
SWAGGER_ENABLED=true

# Comma-separated proxy CIDRs allowed to set X-Forwarded-For. Leave empty on Render.
TRUSTED_PROXIES=
